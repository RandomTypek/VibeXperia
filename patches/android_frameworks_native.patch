 void SensorDevice::handleHidlDeath(const std::string & detail) {
-    // restart is the only option at present.
-    LOG_ALWAYS_FATAL("Abort due to ISensors hidl service failure, detail: %s.", detail.c_str());
+    // nicki (ported from 15.1): the legacy Sony/Bosch sensors HAL can crash
+    // during HIDL calls. Upstream LOG_ALWAYS_FATAL here takes system_server
+    // down with it (boot loop). Don't abort — log and carry on with no working
+    // sensors so the device boots. (SensorDevice already tolerates a
+    // non-functional HAL: every method early-returns.)
+    ALOGE("ISensors HIDL service failure (continuing without sensors): %s.",
+          detail.c_str());
 }
 
