diff --git a/net/netlink_utils.cpp b/net/netlink_utils.cpp
index adaa37e..50f6db0 100644
--- a/net/netlink_utils.cpp
+++ b/net/netlink_utils.cpp
@@ -505,11 +505,27 @@ bool NetlinkUtils::GetStationInfo(uint32_t interface_index,
     LOG(ERROR) << "Failed to get NL80211_STA_INFO_TX_BITRATE";
     return false;
   }
-  uint32_t tx_bitrate;
-  if (!tx_bitrate_attr.GetAttributeValue(NL80211_RATE_INFO_BITRATE32,
-                                         &tx_bitrate)) {
-    LOG(ERROR) << "Failed to get NL80211_RATE_INFO_BITRATE32";
-    return false;
+  // nicki/prima: the old wcnss/prima driver reports the TX bitrate in the
+  // legacy 16-bit NL80211_RATE_INFO_BITRATE attribute, NOT the 32-bit
+  // NL80211_RATE_INFO_BITRATE32 that Pie wificond expects. Failing the whole
+  // GetStationInfo() over the missing 32-bit attr made every signal poll return
+  // "Invalid signal poll result from wificond" to the framework -> WifiInfo RSSI
+  // stayed -127 -> NO Wi-Fi signal bars in the status bar (even though the link
+  // is up and `iw wlan0 link` shows a valid signal/bitrate). Fall back to the
+  // 16-bit attribute (same 100kbps units), and treat the bitrate as
+  // non-essential -- default to 0 and still return the RSSI rather than failing
+  // the query, since the RSSI is what the signal bars need.
+  uint32_t tx_bitrate = 0;
+  uint16_t tx_bitrate_legacy = 0;
+  if (tx_bitrate_attr.GetAttributeValue(NL80211_RATE_INFO_BITRATE32,
+                                        &tx_bitrate)) {
+    // 32-bit bitrate present (modern drivers): use as-is.
+  } else if (tx_bitrate_attr.GetAttributeValue(NL80211_RATE_INFO_BITRATE,
+                                               &tx_bitrate_legacy)) {
+    tx_bitrate = tx_bitrate_legacy;
+  } else {
+    LOG(WARNING) << "No NL80211_RATE_INFO_BITRATE32/BITRATE; reporting 0";
+    tx_bitrate = 0;
   }
 
   *out_station_info = StationInfo(tx_good, tx_bad, tx_bitrate, current_rssi);
