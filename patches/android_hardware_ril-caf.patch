diff --git a/libril/ril_service.cpp b/libril/ril_service.cpp
index 2e57bb5..3d075e8 100644
--- a/libril/ril_service.cpp
+++ b/libril/ril_service.cpp
@@ -4067,9 +4067,14 @@ int radio::setupDataCallResponse(int slotId,
 
         SetupDataCallResult result = {};
 
-        if (response == NULL || (responseLen % sizeof(RIL_Data_Call_Response_v11) != 0
-                && responseLen % sizeof(RIL_Data_Call_Response_v9) != 0
-                && responseLen % sizeof(RIL_Data_Call_Response_v6) != 0)) {
+        // nicki/qcril quirk: the QCOM RIL returns a single RIL_Data_Call_Response_v11
+        // with one extra trailing byte (responseLen == 45, sizeof(v11) == 44). The
+        // upstream strict "responseLen % sizeof(...) == 0" check rejects that as an
+        // INVALID_RESPONSE, which the framework treats as a permanent HAL error
+        // ("All APNs permanently failed") and never retries. Accept any buffer at
+        // least as large as a given struct version and parse its leading fields,
+        // tolerating trailing padding. (setupDataCall always returns a single call.)
+        if (response == NULL || responseLen < sizeof(RIL_Data_Call_Response_v6)) {
             if (response != NULL) {
                 RLOGE("setupDataCallResponse: Invalid response");
                 if (e == RIL_E_SUCCESS) responseInfo.error = RadioError::INVALID_RESPONSE;
@@ -4081,11 +4086,11 @@ int radio::setupDataCallResponse(int slotId,
             result.dnses = hidl_string();
             result.gateways = hidl_string();
             result.pcscf = hidl_string();
-        } else if ((responseLen % sizeof(RIL_Data_Call_Response_v11)) == 0) {
+        } else if (responseLen >= sizeof(RIL_Data_Call_Response_v11)) {
             convertRilDataCallToHal((RIL_Data_Call_Response_v11 *) response, result);
-        } else if ((responseLen % sizeof(RIL_Data_Call_Response_v9)) == 0) {
+        } else if (responseLen >= sizeof(RIL_Data_Call_Response_v9)) {
             convertRilDataCallToHal((RIL_Data_Call_Response_v9 *) response, result);
-        } else if ((responseLen % sizeof(RIL_Data_Call_Response_v6)) == 0) {
+        } else {
             convertRilDataCallToHal((RIL_Data_Call_Response_v6 *) response, result);
         }
 
diff --git a/rild/rild.legacy.rc b/rild/rild.legacy.rc
index b27e1da..64fd2a6 100644
--- a/rild/rild.legacy.rc
+++ b/rild/rild.legacy.rc
@@ -2,4 +2,12 @@ service ril-daemon /vendor/bin/hw/rild
     class main
     user radio
     group radio cache inet misc audio log readproc wakelock
-    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
+    # nicki (msm8x27, kernel 3.4): CAP_BLOCK_SUSPEND (cap 36) does not exist on
+    # this kernel (CAP_LAST_CAP == CAP_WAKE_ALARM == 35). init raises the ambient
+    # capability set one cap at a time and aborts on the first that fails, so the
+    # invalid BLOCK_SUSPEND made the whole line a no-op -> rild ran with CapEff=0,
+    # no CAP_NET_ADMIN -> libdsi_netctrl's generic-netlink multicast bind to the
+    # netmgr group failed -> dsi_init never completed -> qcril "unable to get dsi
+    # hndl" -> mobile data never came up. Dropping BLOCK_SUSPEND lets the valid
+    # caps reach rild via the ambient backport (same path WiFi HAL/netmgrd use).
+    capabilities NET_ADMIN NET_RAW
