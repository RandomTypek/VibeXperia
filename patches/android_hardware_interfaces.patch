+// nicki: the legacy HAL1 camera blob (camera.vendor.msm8960.so) reads the preview
+// buffer's mapped CPU address straight out of the QC private_handle_t (->base); it
+// imports no gralloc/mapper symbols of its own. Oreo's gralloc mapper imports
+// lazily (no mmap until lock), so after HandleImporter::importBuffer ->base is
+// still 0 -> the blob null-derefs in QCameraStream_preview::initDisplayBuffers().
+// Force the mmap by locking each freshly-imported buffer through the SAME legacy
+// gralloc0 module that allocated it, which populates ->base.
+static const gralloc_module_t* nickiGrallocModule() {
+    static const gralloc_module_t* sMod = []() -> const gralloc_module_t* {
+        const hw_module_t* mod = nullptr;
+        if (hw_get_module(GRALLOC_HARDWARE_MODULE_ID, &mod) != 0 || mod == nullptr) {
+            ALOGE("nicki: hw_get_module(gralloc) failed; preview buffers won't be mapped");
+            return nullptr;
+        }
+        return reinterpret_cast<const gralloc_module_t*>(mod);
+    }();
+    return sMod;
+}
