--- a/packages/SystemUI/src/com/android/systemui/statusbar/phone/PanelView.java
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/phone/PanelView.java
@@ -1170,6 +1170,13 @@ public abstract class PanelView extends FrameLayout {
     }
 
     protected void notifyBarPanelExpansionChanged() {
+        // On slow devices the PhoneStatusBarView/PanelBar is wired up asynchronously
+        // via the CollapsedStatusBarFragment attach callback (StatusBar.makeStatusBarView).
+        // Keyguard show during boot can call expand() before that callback runs, leaving
+        // mBar null. Skip this notification; it is re-sent once setBar() runs.
+        if (mBar == null) {
+            return;
+        }
         mBar.panelExpansionChanged(mExpandedFraction, mExpandedFraction > 0f
                 || mPeekAnimator != null || mInstantExpanding || isPanelVisibleBecauseOfHeadsUp()
                 || mTracking || mHeightAnimator != null);
