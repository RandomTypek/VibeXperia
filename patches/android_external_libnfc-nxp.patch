diff --git a/src/phHal4Nfc.c b/src/phHal4Nfc.c
index df72bd8..8dfef4c 100644
--- a/src/phHal4Nfc.c
+++ b/src/phHal4Nfc.c
@@ -306,7 +306,13 @@ phHal4Nfc_Configure_Layers(
 #include <utils/Log.h>
 #include <dlfcn.h>
 
-#define FW_PATH "/vendor/firmware/libpn544_fw.so"
+/* nicki: was /vendor/firmware/libpn544_fw.so, but the app linker namespace for
+ * com.android.nfc (where libnfc dlopens this) permits /system/vendor/lib but NOT
+ * /system/vendor/firmware -> "Could not open ... libpn544_fw.so", the FW update
+ * is skipped, and HCI init then times out -> phHciNfc_Response_Timeout ->
+ * phOsalNfc_RaiseException -> abort (com.android.nfc crash). /vendor/lib
+ * (== /system/vendor/lib, non-Treble) IS permitted. Same fix as 15.1. */
+#define FW_PATH "/vendor/lib/libpn544_fw.so"
 
 const unsigned char *nxp_nfc_full_version = NULL;
 const unsigned char *nxp_nfc_fw = NULL;
