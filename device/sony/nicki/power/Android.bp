// Legacy power_module loaded by the android.hardware.power@1.0 passthrough to
// implement LineageOS performance-profile switching (cpufreq-direct), replacing
// the generic no-op power.default.so. Named power.msm8960 (not power.qcom --
// that name is already taken by device/qcom/common/power, which builds but
// doesn't install its stock perfd-based HAL): hw_get_module() tries power.qcom.so
// (ro.hardware/ro.product.board) first, misses (not installed), then loads
// power.msm8960.so via the ro.board.platform=msm8960 variant. Installs to
// /system/lib/hw, which hw_get_module() searches.
cc_library_shared {
    name: "power.msm8960",
    relative_install_path: "hw",
    srcs: ["power-nicki.c"],
    header_libs: ["libhardware_headers"],
    shared_libs: [
        "liblog",
        "libcutils",
    ],
    cflags: ["-Wall", "-Werror"],
}

cc_binary {
    name: "vendor.lineage.power@1.0-service.nicki",
    init_rc: ["vendor.lineage.power@1.0-service.nicki.rc"],
    relative_install_path: "hw",
    // nicki 16.0 is non-Treble (no BOARD_VNDK_VERSION), so Pie generates no
    // "_vendor" VNDK variant of the interface (Oreo did, which is why the 15.1
    // Android.bp used vendor.lineage.power@1.0_vendor + proprietary:true).
    // Build as a plain system HAL in /system/bin/hw against the plain interface.
    srcs: ["service.cpp"],
    shared_libs: [
        "libbase",
        "libhidlbase",
        "libhidltransport",
        "libutils",
        "liblog",
        "vendor.lineage.power@1.0",
    ],
}
